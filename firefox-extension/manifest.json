{
  "manifest_version": 2,
  "name": "Stream Orbs - Whatnot Chat Monitor",
  "version": "1.0.0",
  "description": "Monitor Whatnot chat and integrate with Stream Orbs application",
  
  "permissions": [
    "activeTab",
    "storage",
    "http://localhost:3001/*",
    "*://*.whatnot.com/*"
  ],
  
  "content_scripts": [
    {
      "matches": ["*://*.whatnot.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Stream Orbs Chat Monitor",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  
  "web_accessible_resources": [
    "injected.js"
  ]
}
